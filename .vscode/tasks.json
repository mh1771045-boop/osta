{
  // In a GitHub Codespace, start Osta as soon as the folder opens (see .devcontainer).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Osta",
      "type": "shell",
      "command": "if command -v osta-start >/dev/null 2>&1; then osta-start; fi",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
