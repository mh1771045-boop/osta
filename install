#!/usr/bin/env bash
# Osta installer: downloads the right build from GitHub Releases into ~/.osta/bin.
#   curl -fsSL https://raw.githubusercontent.com/mh1771045-boop/osta/main/install | bash
set -euo pipefail
APP=osta
REPO=mh1771045-boop/osta

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m'

usage() {
    cat <<EOF
Osta installer

Usage: install [options]

Options:
    -h, --help              Show this help
    -v, --version <version> Install a specific version (e.g. 0.1.0)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't add Osta to PATH in your shell config

Examples:
    curl -fsSL https://raw.githubusercontent.com/$REPO/main/install | bash
    curl -fsSL https://raw.githubusercontent.com/$REPO/main/install | bash -s -- --version 0.1.0
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -v|--version)
            [[ -n "${2:-}" ]] || { echo -e "${RED}Error: --version needs a version${NC}"; exit 1; }
            requested_version="${2#v}"; shift 2 ;;
        -b|--binary)
            [[ -n "${2:-}" ]] || { echo -e "${RED}Error: --binary needs a path${NC}"; exit 1; }
            binary_path="$2"; shift 2 ;;
        --no-modify-path) no_modify_path=true; shift ;;
        *) echo -e "${ORANGE}Warning: unknown option '$1'${NC}" >&2; shift ;;
    esac
done

INSTALL_DIR=$HOME/.osta/bin
mkdir -p "$INSTALL_DIR"

raw_os=$(uname -s)
case "$raw_os" in
    Darwin*) os="darwin" ;;
    Linux*) os="linux" ;;
    MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    *) echo -e "${RED}Unsupported OS: $raw_os${NC}"; exit 1 ;;
esac

arch=$(uname -m)
case "$arch" in
    aarch64|arm64) arch="arm64" ;;
    x86_64|amd64) arch="x64" ;;
    *) echo -e "${RED}Unsupported CPU: $arch${NC}"; exit 1 ;;
esac

# An x64 shell under Rosetta still runs on Apple silicon.
if [ "$os" = "darwin" ] && [ "$arch" = "x64" ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" = "1" ]; then
    arch="arm64"
fi

binary="$APP"
[ "$os" = "windows" ] && binary="$APP.exe"

if [ -n "$binary_path" ]; then
    [ -f "$binary_path" ] || { echo -e "${RED}Error: binary not found at $binary_path${NC}"; exit 1; }
    cp "$binary_path" "$INSTALL_DIR/$binary"
    chmod 755 "$INSTALL_DIR/$binary"
else
    target="$os-$arch"
    if [ "$arch" = "x64" ]; then
        if [ "$os" = "linux" ] && ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then target="$target-baseline"; fi
        if [ "$os" = "darwin" ] && [ "$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)" != "1" ]; then target="$target-baseline"; fi
    fi
    if [ "$os" = "linux" ]; then
        if [ -f /etc/alpine-release ] || (command -v ldd >/dev/null 2>&1 && ldd --version 2>&1 | grep -qi musl); then
            target="$target-musl"
        fi
    fi

    ext="tar.gz"
    [ "$os" = "windows" ] && ext="zip"
    asset="$APP-$target.$ext"
    if [ -n "$requested_version" ]; then
        url="https://github.com/$REPO/releases/download/v$requested_version/$asset"
        label="$requested_version"
    else
        url="https://github.com/$REPO/releases/latest/download/$asset"
        label="latest"
    fi

    echo -e "\n${MUTED}Installing ${NC}$APP ${MUTED}($label, $target)${NC}"
    tmp_dir="${TMPDIR:-/tmp}/osta_install_$$"
    mkdir -p "$tmp_dir"
    trap 'rm -rf "$tmp_dir"' EXIT
    if ! curl -fL -# -o "$tmp_dir/$asset" "$url"; then
        echo -e "${RED}Could not download $url${NC}"
        echo -e "${MUTED}Check the releases page: https://github.com/$REPO/releases${NC}"
        exit 1
    fi
    if [ "$ext" = "zip" ]; then
        unzip -oq "$tmp_dir/$asset" -d "$tmp_dir"
    else
        tar -xzf "$tmp_dir/$asset" -C "$tmp_dir"
    fi
    mv "$tmp_dir/bin/$binary" "$INSTALL_DIR/$binary"
    chmod 755 "$INSTALL_DIR/$binary"
fi

add_to_path() {
    local config_file=$1 command=$2
    if grep -Fxq "$command" "$config_file" 2>/dev/null; then
        return
    elif [[ -w $config_file ]]; then
        printf '\n# osta\n%s\n' "$command" >> "$config_file"
        echo -e "${MUTED}Added ${NC}osta ${MUTED}to PATH in ${NC}$config_file"
    else
        echo -e "${ORANGE}Add this line to $config_file (or similar):${NC}"
        echo "  $command"
    fi
}

if [ "$no_modify_path" != "true" ] && [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
    case $(basename "${SHELL:-bash}") in
        fish) add_to_path "$HOME/.config/fish/config.fish" "fish_add_path $INSTALL_DIR" ;;
        zsh)
            config="${ZDOTDIR:-$HOME}/.zshrc"
            [ -f "$config" ] || touch "$config"
            add_to_path "$config" "export PATH=$INSTALL_DIR:\$PATH" ;;
        *)
            config="$HOME/.bashrc"
            [ -f "$config" ] || touch "$config"
            add_to_path "$config" "export PATH=$INSTALL_DIR:\$PATH" ;;
    esac
fi

echo -e ""
echo -e "  ${NC}Osta (أسطى) is installed."
echo -e "  ${MUTED}Open a new terminal, go to a project folder, and run:${NC}"
echo -e ""
echo -e "    osta"
echo -e ""
echo -e "  ${MUTED}Free models work out of the box, no account or API key needed.${NC}"
echo -e ""
